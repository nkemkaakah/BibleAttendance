# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (resend.com -> API Keys)
RESEND_API_KEY=re_...

# Password for the /admin page (pick something she can remember)
ADMIN_PASSWORD=choose-a-password

# The deployed URL (used inside the QR code). Update after first deploy.
APP_URL=https://your-app.vercel.app

# Group's local timezone (IANA name). 9PM expiry is computed in this zone.
TIMEZONE=Europe/London

# Protects /api/cron/daily. Set the same value in Vercel.
CRON_SECRET=any-long-random-string
